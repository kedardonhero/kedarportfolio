rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- FinTrack (unchanged) ----------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /splitwiseLinks/{uid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /splitwiseSync/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /expenses/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------- Split in Half (separate collections, never touches FinTrack's data) ----------
    match /sih_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /sih_groups/{gid} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      allow update: if request.auth != null && (
          request.auth.uid in resource.data.memberIds
          || (request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
              && request.auth.uid in request.resource.data.memberIds));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
      match /expenses/{eid} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/sih_groups/$(gid)).data.memberIds;
      }
    }
  }
}
